# Deny by default; allow only files intended for version control.
*
!/.gitignore
!/mise.toml
!/mise.lock
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/tsconfig.test.json
!/.oxlintrc.json
!/.oxfmtrc.json
!/knip.json
!/vitest.config.ts
!/LICENSE
!/README.md

!/src/
!/src/**/
!/src/**/*.ts
!/test/
!/test/**/
!/test/**/*.ts
!/test/fixtures/consumer/smoke.mjs
!/test/fixtures/consumer/tsconfig.json
!/scripts/
!/scripts/*.mjs
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/apps/
!/apps/demo/
!/apps/demo/package.json
!/apps/demo/.env.schema
!/apps/demo/tsconfig.json
!/apps/demo/next.config.ts
!/apps/demo/vitest.config.ts
!/apps/demo/src/
!/apps/demo/src/**/
!/apps/demo/src/**/*.ts
!/apps/demo/src/**/*.tsx
!/apps/demo/src/**/*.css
!/apps/demo/test/
!/apps/demo/test/**/
!/apps/demo/test/**/*.ts
!/apps/demo/test/**/*.tsx
!/apps/cli/
!/apps/cli/package.json
!/apps/cli/README.md
!/apps/cli/LICENSE
!/apps/cli/tsconfig.json
!/apps/cli/tsconfig.test.json
!/apps/cli/vitest.config.ts
!/apps/cli/src/
!/apps/cli/src/**/
!/apps/cli/src/**/*.ts
!/apps/cli/test/
!/apps/cli/test/**/
!/apps/cli/test/**/*.ts
