# Deny by default; allow only files intended for version control.
*
!/.gitignore
!/mise.toml
!/mise.lock
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/tsconfig.test.json
!/.oxlintrc.json
!/.oxfmtrc.json
!/knip.json
!/vitest.config.ts
!/LICENSE
!/README.md

!/src/
!/src/**/
!/src/**/*.ts
!/test/
!/test/**/
!/test/**/*.ts
!/test/fixtures/consumer/smoke.mjs
!/test/fixtures/consumer/tsconfig.json
!/scripts/
!/scripts/*.mjs
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

!/sites/
!/sites/demo/
!/sites/demo/package.json
!/sites/demo/tsconfig.json
!/sites/demo/next.config.ts
!/sites/demo/next-env.d.ts
!/sites/demo/vitest.config.ts
!/sites/demo/src/
!/sites/demo/src/**/
!/sites/demo/src/**/*.ts
!/sites/demo/src/**/*.tsx
!/sites/demo/src/**/*.css
!/sites/demo/test/
!/sites/demo/test/**/
!/sites/demo/test/**/*.ts
!/sites/demo/test/**/*.tsx
