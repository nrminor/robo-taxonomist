# Deny by default; allow only files intended for version control.
*
!/.gitignore
!/mise.toml
!/mise.lock
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/tsconfig.test.json
!/.oxlintrc.json
!/.oxfmtrc.json
!/knip.json
!/vitest.config.ts
!/LICENSE
!/README.md

!/src/
!/src/**/
!/src/**/*.ts
!/test/
!/test/**/
!/test/**/*.ts
!/test/fixtures/consumer/smoke.mjs
!/test/fixtures/consumer/tsconfig.json
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
