{
  "name": "robo-taxonomist",
  "version": "0.0.0",
  "description": "Effect-based taxonomy reconciliation and set operations across taxonomic databases.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "pnpm run fmt:check && pnpm run check:fast && pnpm run test && pnpm run knip && pnpm run check:consumer",
    "check:consumer": "tsc --project test/fixtures/consumer/tsconfig.json && node test/fixtures/consumer/smoke.mjs",
    "check:fast": "pnpm run lint && pnpm run typecheck",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "pnpm run build && oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.54.1",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.19.0",
    "effect": "4.0.0",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
