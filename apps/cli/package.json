{
  "name": "@robo-taxonomist/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "robo-taxonomist": "dist/main.js"
  },
  "type": "module",
  "scripts": {
    "dev": "node src/main.ts",
    "build": "tsc --project tsconfig.json && chmod +x dist/main.js",
    "compile": "bun build --compile --env=disable --no-compile-autoload-dotenv --no-compile-autoload-bunfig --no-compile-autoload-tsconfig --no-compile-autoload-package-json --outfile ../../artifacts/cli/robo-taxonomist src/main.ts",
    "typecheck": "tsc --project tsconfig.test.json && effect-tsgo diagnostics --project tsconfig.test.json --strict",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@effect/ai-typesafe": "4.1.1",
    "@effect/platform-node": "4.1.1",
    "effect": "4.1.1",
    "robo-taxonomist": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "24.19.0",
    "vitest": "5.0.5"
  }
}
